+/// ZMIX-EDIT: the episode facts the panel reads, fed from ZMIX's
+/// LibraryVideo. Upstream's Episode carries seasons/filler/dates; a YouTube
+/// playlist has none of those, so season is always 1 (the season UI never
+/// engages, same as a single-season title upstream) and there is no filler
+/// or air date.
+class ZmixPanelEpisode {
+  const ZmixPanelEpisode({
+    required this.number,
+    this.title,
+    this.thumbnail,
+    this.runtimeSeconds,
+  });
+
+  final int number;
+  final String? title;
+  final String? thumbnail;
+  final int? runtimeSeconds;
+}
+
+/// ZMIX-EDIT: upstream's stripGenericEpisodePrefix (core/models/
+/// episode_title.dart) copied verbatim - drops a leading generic
+/// "Episode 12" / "Ep. 12" / "E12" / "12." marker.
+String stripEpisodePrefix(String title, int n) {
+  final t = title.trim();
+  final word = RegExp(
+    '^(?:episode|ep\\.?|e)\\s*0*$n(?![0-9])\\s*[:\\-–—.)\\]]*\\s*',
+    caseSensitive: false,
+  );
+  final bare = RegExp('^0*$n(?![0-9])\\s*[:\\-–—.)\\]]+\\s*');
+  final m = word.firstMatch(t) ?? bare.firstMatch(t);
+  if (m == null) return t;
+  return t.substring(m.end).trim();
+}
 
